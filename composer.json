{
  "name": "y-collective/sage-lib",
  "license": "MIT",
  "description": "Library files for Sage Starter Theme — PHP 8.3+ / Laravel 13 fork",
  "homepage": "https://roots.io/sage/",
  "authors": [
    {
      "name": "QWp6t",
      "email": "hi@qwp6t.me",
      "homepage": "https://github.com/qwp6t"
    },
    {
      "name": "Ben Word",
      "email": "ben@benword.com",
      "homepage": "https://github.com/retlehs"
    }
  ],
  "keywords": [
    "wordpress"
  ],
  "support": {
    "issues": "https://github.com/y-collective/sage-lib/issues",
    "forum": "https://discourse.roots.io/"
  },
  "autoload": {
    "psr-4": {
      "Roots\\Sage\\": ""
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Roots\\Sage\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.3",
    "composer/installers": "^2.3",
    "illuminate/view": "^13.2.0",
    "illuminate/config": "^13.2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "scripts": {
    "test": [
      "phpunit",
      "phpcs --ignore=vendor --extensions=php --standard=PSR12 ."
    ],
    "lint": "phpcs --ignore=vendor --extensions=php --standard=PSR12 .",
    "fix": "phpcbf --ignore=vendor --extensions=php --standard=PSR12 ."
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
